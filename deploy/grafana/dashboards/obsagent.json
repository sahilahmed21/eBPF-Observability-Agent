  "panels": [
    {
      "title": "HTTP latency p50/p99 (exclude grpc)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_client_duration_milliseconds_bucket{http_protocol!=\"grpc\"}[1m])) by (le, http_route))",
          "legendFormat": "p50 {{http_route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_client_duration_milliseconds_bucket{http_protocol!=\"grpc\"}[1m])) by (le, http_route))",
          "legendFormat": "p99 {{http_route}}"
        }
      ]
    },
    {
      "title": "gRPC latency p50/p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_client_duration_milliseconds_bucket{http_protocol=\"grpc\"}[1m])) by (le, http_route))",
          "legendFormat": "p50 {{http_route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_client_duration_milliseconds_bucket{http_protocol=\"grpc\"}[1m])) by (le, http_route))",
          "legendFormat": "p99 {{http_route}}"
        }
      ]
    },
    {
      "title": "TLS handshake p50",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(tls_handshake_duration_milliseconds_bucket[1m])) by (le))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "title": "Request rate by edge",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_client_requests_total[1m])) by (src, dst)",
          "legendFormat": "{{src}} → {{dst}}"
        }
      ]
    },
    {
      "title": "Agent drops",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "obsagent_events_dropped_total",
          "legendFormat": "ringbuf"
        },
        {
          "expr": "obsagent_otlp_dropped_total",
          "legendFormat": "otlp"
        },
        {
          "expr": "obsagent_traces_dropped_total",
          "legendFormat": "traces_queue"
        },
        {
          "expr": "obsagent_traces_export_failed_total",
          "legendFormat": "traces_export"
        }
      ]
    },
    {
      "title": "Trace sampling",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(obsagent_traces_sampled_total[1m])",
          "legendFormat": "sampled"
        },
        {
          "expr": "rate(obsagent_traces_not_sampled_total[1m])",
          "legendFormat": "not_sampled"
        }
      ]
    },
    {
      "title": "Service map (src → dst)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (src, dst) (increase(http_client_requests_total[5m]))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "title": "Service map edge count",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "obsagent_service_map_edges",
          "legendFormat": "edges"
        }
      ]
    }
